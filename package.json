{
  "name": "nextdns-skills",
  "version": "1.0.0",
  "description": "Comprehensive AI agent skills for NextDNS management, covering API integration, CLI operations, and Web UI configuration best practices.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuanductran/nextdns-skills.git"
  },
  "homepage": "https://github.com/tuanductran/nextdns-skills#readme",
  "bugs": {
    "url": "https://github.com/tuanductran/nextdns-skills/issues"
  },
  "author": "Tuan Duc Tran <tuanductran.dev@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "keywords": [
    "nextdns",
    "dns",
    "security",
    "privacy",
    "parental-control",
    "ddns",
    "denylist",
    "allowlist",
    "analytics",
    "logs",
    "configuration",
    "threat-modeling",
    "setup-optimization",
    "troubleshooting",
    "api",
    "cli",
    "ui",
    "agent-skills",
    "ai-agent"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "pnpm run format:check && pnpm run types:check && pnpm run \"/^lint:(md|rules|syntax)$/\"",
    "lint:all": "pnpm run lint && pnpm run lint:links",
    "lint:fix": "pnpm run format && pnpm run lint:md:fix && pnpm run lint:syntax:fix && pnpm run lint:rules && pnpm run types:check",
    "lint:links": "find . -name \"*.md\" -not -path \"*/node_modules/*\" -not -path \"*/templates/*\" | xargs markdown-link-check -c config.json",
    "lint:md": "markdownlint .",
    "lint:md:fix": "markdownlint . --fix",
    "lint:rules": "turbo run validate-rules",
    "lint:syntax": "case-police \"skills/**/rules/**/*.md\"",
    "lint:syntax:fix": "case-police --fix \"skills/**/rules/**/*.md\"",
    "build": "turbo run build",
    "build:skills": "turbo run build-all",
    "build:api": "turbo run build-api",
    "build:cli": "turbo run build-cli",
    "build:ui": "turbo run build-ui",
    "build:integrations": "turbo run build-integrations",
    "build:frontend": "turbo run build-frontend",
    "update-counts": "turbo run update-counts",
    "dev": "turbo run dev",
    "check-duplicates": "turbo run check-duplicates",
    "check-tags": "turbo run check-tags",
    "stats": "turbo run generate-stats -- --text",
    "lint:quality": "turbo run check-duplicates check-tags",
    "rule-search": "turbo run search --",
    "rule-export": "turbo run export --",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "types:check": "turbo run types:check && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "case-police": "^2.2.1",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli": "^0.49.1",
    "turbo": "^2.10.7",
    "typescript": "6.0.3"
  }
}
