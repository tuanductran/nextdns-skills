{
  "name": "nextdns-skills-scripts",
  "version": "1.0.0",
  "description": "Maintenance scripts for NextDNS Skills: audit, validate rule integrity, sync counts, check duplicates/tags, and generate stats",
  "keywords": [
    "maintenance",
    "nextdns",
    "scripts",
    "skills",
    "validation"
  ],
  "license": "MIT",
  "bin": {
    "nextdns-skills-scripts": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check-duplicates": "node dist/cli.mjs check-duplicates",
    "check-tags": "node dist/cli.mjs check-tags",
    "audit": "node dist/cli.mjs audit",
    "dev": "vp pack --watch",
    "generate-stats": "node dist/cli.mjs generate-stats",
    "prepublishOnly": "pnpm build",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "types:check": "tsc --noEmit",
    "update-counts": "node dist/cli.mjs update-counts",
    "validate-rules": "node dist/cli.mjs validate-rules"
  },
  "dependencies": {
    "nextdns-markdown": "workspace:*",
    "valibot": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:dev",
    "@vitest/coverage-v8": "catalog:test",
    "typescript": "catalog:dev",
    "vite": "catalog:test",
    "vite-plus": "catalog:test"
  }
}
